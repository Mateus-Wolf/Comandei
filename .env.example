# Copie este arquivo para .env.local e preencha com os dados do seu ambiente.
# Os valores abaixo são exemplos; não inclua credenciais reais neste arquivo.

# Interface: estas variáveis ficam disponíveis no navegador.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000

# Servidor: chave secreta do Supabase usada pela API (ex.: gestão de usuários).
# Nunca use o prefixo NEXT_PUBLIC_ para esta chave.
SUPABASE_SECRET_KEY=

# Administração/migrations somente. Nunca usar no runtime web/API.
# Formato: postgresql://USUARIO:SENHA@HOST:5432/postgres
SUPABASE_DB_URL=
# Credencial restrita usada pelo backend; criada no provisionamento local.
DATABASE_URL=
# Certificado CA usado para verificar as conexões TLS com o banco.
SUPABASE_DB_CA=certs/supabase-ca.crt
# Conexões restritas separadas para worker e administração da plataforma.
WORKER_DATABASE_URL=
PLATFORM_DATABASE_URL=
# UUIDs de operadores da plataforma, separados por vírgula. Sem lista, acesso negado.
PLATFORM_OPERATOR_IDS=
# Origens permitidas, separadas por vírgula.
CORS_ORIGINS=http://localhost:3000
# Defina um token próprio para acesso às métricas da API.
METRICS_TOKEN=

# Para testes de navegador, consulte .env.e2e.example.
