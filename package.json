{
  "name": "comandei",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "supabase": "supabase",
    "db:check": "node --env-file=.env.local scripts/check-database.mjs",
    "typecheck": "next typegen apps/web && tsc --noEmit -p apps/web/tsconfig.json",
    "db:test": "node --env-file=.env.local scripts/test-isolation.mjs",
    "api:dev": "node scripts/api.mjs serve",
    "db:replay": "node scripts/replay-migrations.mjs",
    "api:worker": "node scripts/api.mjs worker",
    "api:test": "node scripts/api.mjs test",
    "api:check": "node scripts/api.mjs check",
    "api:contract": "node scripts/api.mjs contract && openapi-typescript packages/api-client/openapi.json -o packages/api-client/schema.d.ts",
    "web:dev": "node scripts/web.mjs dev",
    "web:test": "node --test scripts/test-web-requests.mjs scripts/test-stock-inputs.mjs scripts/test-financial.mjs scripts/test-attendance.mjs scripts/test-tables.mjs scripts/test-receipt.mjs",
    "web:build": "node scripts/web.mjs build",
    "web:start": "node scripts/web.mjs start",
    "test:playwright": "playwright test",
    "test:playwright:report": "playwright show-report"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "pg": "8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@playwright/test": "^1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "typescript": "5.9.3"
  }
}
