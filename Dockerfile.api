FROM python:3.12-slim
WORKDIR /app
COPY apps/api/requirements.lock.txt /app/apps/api/requirements.lock.txt
RUN pip install --no-cache-dir -r apps/api/requirements.lock.txt && useradd --create-home app
COPY certs /app/certs
COPY apps/api /app/apps/api
ENV PYTHONPATH=/app/apps/api PYTHONUNBUFFERED=1
USER app
EXPOSE 8000
CMD ["uvicorn", "comandei.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-server-header", "--no-access-log"]
